<h1 class="text-xl font-semibold text-[#1a1a2e]"><%= @project.name %></h1>
<p class="mt-1 text-sm text-gray-500">Last 30 days · <%= @from.strftime("%b %-d") %> – <%= @to.strftime("%b %-d, %Y") %></p>

<div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
  <% [
       [ "Visitors", @visitors ],
       [ "Pageviews", @pageviews ],
       [ "Sessions", @sessions ],
       [ "Custom events", @custom_events ]
     ].each do |label, value| %>
    <div class="rounded-xl border border-[#e8e8ee] bg-white p-4">
      <div class="text-[11px] font-medium uppercase tracking-wide text-gray-400"><%= label %></div>
      <div class="mt-1 text-2xl font-semibold text-[#1a1a2e]"><%= number_with_delimiter(value) %></div>
    </div>
  <% end %>
</div>

<div class="mt-6 rounded-xl border border-[#e8e8ee] bg-white p-5">
  <h2 class="text-sm font-medium text-[#1a1a2e]">Daily events</h2>
  <% max = [ @daily.values.max || 0, 1 ].max %>
  <div class="mt-3 flex h-32 items-end gap-1">
    <% @daily.each do |date, count| %>
      <div class="flex-1 rounded-t bg-indigo-500/80"
           style="height: <%= ((count.to_f / max) * 100).round %>%"
           title="<%= date.strftime('%b %-d') %>: <%= count %>"></div>
    <% end %>
    <% if @daily.empty? %><p class="text-sm text-gray-400">No events yet.</p><% end %>
  </div>
</div>

<% if @top_events.any? %>
  <div class="mt-6 rounded-xl border border-[#e8e8ee] bg-white p-5">
    <h2 class="text-sm font-medium text-[#1a1a2e]">Top events</h2>
    <table class="mt-3 w-full text-sm">
      <% @top_events.each do |name, count| %>
        <tr class="border-t border-gray-100">
          <td class="py-1.5 text-gray-700"><%= name %></td>
          <td class="py-1.5 text-right text-gray-700"><%= number_with_delimiter(count) %></td>
        </tr>
      <% end %>
    </table>
  </div>
<% end %>
