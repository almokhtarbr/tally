<%= turbo_stream_from "project_#{@project.id}_events" %>

<%= render "projects/page_header",
  title: @project.name, subtitle: @project.url, back_path: root_path,
  date_form_url: anomalies_project_path(@project), from: @from, to: @to,
  project: @project, active_tab: "Anomalies" %>

<%
  def severity_badge(severity)
    case severity
    when "critical"
      '<span class="inline-block px-2 py-0.5 text-[10px] font-semibold rounded-full bg-[#fef2f2] text-[#ef4444]">CRITICAL</span>'.html_safe
    when "warning"
      '<span class="inline-block px-2 py-0.5 text-[10px] font-semibold rounded-full bg-[#fff7ed] text-[#f97316]">WARNING</span>'.html_safe
    else
      '<span class="inline-block px-2 py-0.5 text-[10px] font-semibold rounded-full bg-[#f0f4ff] text-[#5046e5]">INFO</span>'.html_safe
    end
  end

  def type_icon(type)
    case type
    when "spike" then "^"
    when "drop" then "v"
    when "absence" then "!"
    end
  end
%>

<!-- KPI Row -->
<div class="bg-white rounded-xl border border-[#e8e8ee] mb-4 grid grid-cols-3 divide-x divide-[#f0f0f5]">
  <div class="px-4 py-3">
    <p class="text-[11px] text-[#8b8ba3] font-medium">Active Anomalies</p>
    <span class="text-[20px] font-semibold leading-none mt-1 block tabular-nums" style="color:<%= @active_anomalies.any? ? '#ef4444' : '#1a1a2e' %>"><%= @active_anomalies.size %></span>
  </div>
  <div class="px-4 py-3">
    <p class="text-[11px] text-[#8b8ba3] font-medium">Critical</p>
    <span class="text-[20px] font-semibold leading-none mt-1 block tabular-nums" style="color:<%= @active_anomalies.select { |a| a.severity == 'critical' }.any? ? '#ef4444' : '#1a1a2e' %>"><%= @active_anomalies.select { |a| a.severity == "critical" }.size %></span>
  </div>
  <div class="px-4 py-3">
    <p class="text-[11px] text-[#8b8ba3] font-medium">Resolved (this period)</p>
    <span class="text-[20px] font-semibold text-[#22c55e] leading-none mt-1 block tabular-nums"><%= @resolved_anomalies.size %></span>
  </div>
</div>

<% if @active_anomalies.any? %>
  <!-- Active Alert Banner -->
  <div class="bg-[#fef2f2] border border-[#fecaca] rounded-xl p-4 mb-4">
    <div class="flex items-start gap-3">
      <div class="w-5 h-5 rounded-full bg-[#ef4444] flex items-center justify-center flex-shrink-0 mt-0.5">
        <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
      </div>
      <div>
        <p class="text-[13px] font-semibold text-[#991b1b]"><%= @active_anomalies.size %> active anomal<%= @active_anomalies.size == 1 ? 'y' : 'ies' %> detected</p>
        <% @active_anomalies.first(3).each do |a| %>
          <p class="text-[12px] text-[#991b1b] mt-1"><%= a.description %></p>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<!-- Anomalies List -->
<div class="bg-white rounded-xl border border-[#e8e8ee] mb-4">
  <div class="px-4 py-2.5 border-b border-[#f0f0f5]">
    <p class="text-[13px] font-medium text-[#1a1a2e]">All Anomalies</p>
  </div>
  <% if @all_anomalies.any? %>
    <!-- Header -->
    <div class="flex items-center px-4 py-2 border-b border-[#f0f0f5] text-[11px] text-[#8b8ba3] font-medium">
      <span class="w-[80px]">Severity</span>
      <span class="w-[60px]">Type</span>
      <span class="flex-1">Event</span>
      <span class="w-[120px] text-right">Expected</span>
      <span class="w-[120px] text-right">Actual</span>
      <span class="w-[80px] text-right">Change</span>
      <span class="w-[130px] text-right">Detected</span>
      <span class="w-[80px] text-right">Status</span>
    </div>
    <div class="divide-y divide-[#f8f8fb]">
      <% @all_anomalies.each do |anomaly| %>
        <div class="flex items-center px-4 py-3 hover:bg-[#fafafb] transition-colors">
          <span class="w-[80px]"><%= severity_badge(anomaly.severity) %></span>
          <span class="w-[60px]">
            <% case anomaly.anomaly_type %>
            <% when "spike" %>
              <span class="inline-block px-1.5 py-0.5 text-[10px] font-medium rounded bg-[#fef2f2] text-[#ef4444]">Spike</span>
            <% when "drop" %>
              <span class="inline-block px-1.5 py-0.5 text-[10px] font-medium rounded bg-[#eff6ff] text-[#3b82f6]">Drop</span>
            <% when "absence" %>
              <span class="inline-block px-1.5 py-0.5 text-[10px] font-medium rounded bg-[#fefce8] text-[#eab308]">None</span>
            <% end %>
          </span>
          <div class="flex-1 min-w-0">
            <span class="text-[13px] text-[#2d2d42] font-mono"><%= anomaly.event_name %></span>
            <p class="text-[11px] text-[#8b8ba3] mt-0.5 truncate"><%= anomaly.description %></p>
          </div>
          <span class="w-[120px] text-right text-[13px] font-mono tabular-nums text-[#8b8ba3]"><%= anomaly.expected_value.round(1) %></span>
          <span class="w-[120px] text-right text-[13px] font-mono tabular-nums text-[#2d2d42]"><%= anomaly.actual_value.round(1) %></span>
          <span class="w-[80px] text-right text-[13px] font-mono tabular-nums" style="color:<%= anomaly.change_pct > 0 ? '#ef4444' : '#3b82f6' %>"><%= anomaly.change_pct > 0 ? '+' : '' %><%= anomaly.change_pct %>%</span>
          <span class="w-[130px] text-right text-[11px] text-[#8b8ba3] tabular-nums"><%= anomaly.detected_at.strftime("%b %d %H:%M") %></span>
          <span class="w-[80px] text-right">
            <% if anomaly.active? %>
              <span class="inline-block w-2 h-2 rounded-full bg-[#ef4444] animate-pulse"></span>
              <span class="text-[11px] text-[#ef4444] ml-1">Active</span>
            <% else %>
              <span class="text-[11px] text-[#22c55e]">Resolved</span>
            <% end %>
          </span>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-[13px] text-[#8b8ba3] py-10 text-center">No anomalies detected. The system checks event rates every 10 minutes against a 7-day rolling average.</p>
  <% end %>
</div>
