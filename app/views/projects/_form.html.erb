<%= form_with model: project, class: "max-w-md" do |f| %>
  <% if project.errors.any? %>
    <div class="mb-6 rounded-lg bg-red-50 border border-red-200 px-4 py-3">
      <ul class="text-sm text-red-600 space-y-1">
        <% project.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Project Name</label>
      <%= f.text_field :name, placeholder: "My App" %>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">URL <span class="text-gray-400">(optional)</span></label>
      <%= f.text_field :url, placeholder: "https://myapp.com" %>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Data retention <span class="text-gray-400">(days, optional)</span></label>
      <%= f.number_field :retention_days, min: 1, placeholder: "keep everything" %>
      <p class="text-xs text-gray-400 mt-1">Events older than this are deleted nightly. Blank keeps them.</p>
    </div>

    <div class="flex items-center gap-3 pt-2">
      <%= f.submit class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500 transition cursor-pointer" %>
      <%= link_to "Cancel", projects_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
    </div>
  </div>
<% end %>
