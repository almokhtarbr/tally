<%= render "projects/page_header",
  title: @project.name, subtitle: @project.url, back_path: root_path,
  date_form_url: nil, from: nil, to: nil,
  project: @project, active_tab: "Segments" %>

<div class="flex items-center justify-between mb-4">
  <p class="text-[13px] font-medium text-[#1a1a2e]">User Segments</p>
  <%= link_to "New Segment", new_project_segment_path(@project), class: "bg-[#5046e5] text-white text-[12px] font-medium px-4 py-[6px] rounded-md hover:bg-[#4338ca]" %>
</div>

<% if @segments.any? %>
  <div class="bg-white rounded-xl border border-[#e8e8ee]">
    <% @segments.each_with_index do |segment, idx| %>
      <div class="<%= 'border-t border-[#f0f0f5]' if idx > 0 %> px-4 py-3 flex items-center justify-between">
        <div>
          <%= link_to segment.name, project_segment_path(@project, segment), class: "text-[13px] font-medium text-[#5046e5] hover:underline" %>
          <% if segment.description.present? %>
            <p class="text-[11px] text-[#8b8ba3] mt-0.5"><%= segment.description.truncate(80) %></p>
          <% end %>
          <p class="text-[11px] text-[#8b8ba3] mt-0.5"><%= segment.conditions.size %> condition<%= segment.conditions.size == 1 ? "" : "s" %></p>
        </div>
        <div class="flex items-center gap-3">
          <%= link_to "Edit", edit_project_segment_path(@project, segment), class: "text-[11px] text-[#8b8ba3] hover:text-[#5046e5]" %>
          <%= link_to "Delete", project_segment_path(@project, segment), data: { turbo_method: :delete, turbo_confirm: "Delete this segment?" }, class: "text-[11px] text-[#ef4444] hover:underline" %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-[#e8e8ee] p-10 text-center">
    <p class="text-[13px] text-[#8b8ba3] mb-3">No segments yet. Create one to filter any report by user behavior.</p>
    <%= link_to "Create Segment", new_project_segment_path(@project), class: "text-[13px] text-[#5046e5] hover:underline" %>
  </div>
<% end %>
