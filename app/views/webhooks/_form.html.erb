<div class="bg-white rounded-xl border border-[#e8e8ee] p-5 max-w-xl">
  <%= form_with model: [project, webhook], class: "space-y-4" do |f| %>
    <% if webhook.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-3">
        <% webhook.errors.full_messages.each do |msg| %>
          <p class="text-[12px] text-red-700"><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <label class="text-[12px] text-[#4a4a68] font-medium block mb-1">URL</label>
      <%= f.url_field :url, class: "w-full text-[13px] text-[#2d2d42] bg-[#fafafb] border border-[#e8e8ee] rounded-md px-3 py-2 font-mono", placeholder: "https://example.com/webhook" %>
    </div>

    <div>
      <label class="text-[12px] text-[#4a4a68] font-medium block mb-1">Events to trigger on</label>
      <div class="space-y-1 max-h-[200px] overflow-y-auto bg-[#fafafb] rounded-md border border-[#e8e8ee] p-3">
        <% available_events.each do |event| %>
          <label class="flex items-center gap-2 text-[12px] text-[#4a4a68]">
            <input type="checkbox" name="webhook[event_names][]" value="<%= event %>" <%= "checked" if webhook.event_names.include?(event) %> class="rounded border-[#e8e8ee]">
            <span class="font-mono"><%= event %></span>
          </label>
        <% end %>
      </div>
      <p class="text-[11px] text-[#8b8ba3] mt-1">Select * for all events.</p>
    </div>

    <div class="flex items-center gap-3 pt-2">
      <%= f.submit webhook.persisted? ? "Update Webhook" : "Create Webhook", class: "bg-[#5046e5] text-white text-[12px] font-medium px-4 py-[6px] rounded-md hover:bg-[#4338ca] cursor-pointer" %>
      <%= link_to "Cancel", project_webhooks_path(project), class: "text-[12px] text-[#8b8ba3] hover:text-[#4a4a68]" %>
    </div>
  <% end %>
</div>
